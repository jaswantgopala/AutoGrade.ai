# ─── Google OAuth ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── JWT ───
# Must be a cryptographically random string ≥ 256 bits.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=7d

# ─── MongoDB ───
MONGODB_URI=

# ─── URLs ───
BE_BASE_URL=http://localhost:3000
FE_BASE_URL=http://localhost:3001

# ─── Pinecone ───
PINECONE_API_KEY=
PINECONE_INDEX_NAME=autograde

# ─── Gemini ───
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── AWS S3 ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=

# ─── Google Cloud Storage ───
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./gcs.json
OCR_GOOGLE_APPLICATION_CREDENTIALS=./gcs.json
OCR_PROJECT_ID=

# ─── Redis ───
REDIS_URL=
REDIS_PASSWORD=

# ─── Razorpay ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Billing ───
BILLING_PROFIT_MARGIN_PERCENT=30

# ─── Token Encryption ───
# AES-256-GCM key for encrypting Google OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ─── Grading Worker ───
GRADING_WORKER_CONCURRENCY=2

# ─── Free tier ───
FREE_COPIES_PER_ACCOUNT=5
PAID_COPY_COST_INR=7

# ─── Alerts (optional) ───
ALERT_WEBHOOK_URL=
